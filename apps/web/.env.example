# PNW Twin — environment

# Cesium Ion access token (required for Google Photorealistic 3D Tiles).
# Get yours at https://cesium.com/ion → Access Tokens
VITE_CESIUM_ION_TOKEN=

# AISStream.io API key (required for live ship positions).
# Register at https://aisstream.io
VITE_AISSTREAM_API_KEY=

# NASA FIRMS API key (optional — improves wildfire fetch reliability).
# Register at https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=

# Methods ingest bearer token (optional in dev, REQUIRED in production).
# External seismic-method pipelines (dv/v, HVSR, RF) must send this as
#   Authorization: Bearer <value>
# when POSTing to /api/methods/sample, /api/methods/geoproduct, /api/methods/event.
METHODS_INGEST_TOKEN=
